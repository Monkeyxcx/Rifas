{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev --turbopack",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["sfo1", "iad1", "gru1"],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/api/mercadopago/webhook",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ],
  "images": {
    "minimumCacheTTL": 31_536_000,
    "formats": ["image/avif", "image/webp"],
    "remotePatterns": [
      { "protocol": "https", "hostname": "*.supabase.co" },
      { "protocol": "https", "hostname": "coresg-normal.trae.ai" },
      { "protocol": "https", "hostname": "images.unsplash.com" }
    ]
  },
  "functions": {
    "app/api/mercadopago/webhook/route.ts": {
      "maxDuration": 15
    },
    "app/api/reservar/route.ts": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cron/limpiar-reservas",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/cerrar-rifas-vencidas",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/revisar-pagos-pendientes",
      "schedule": "0 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "desarrollo": true
    }
  }
}
