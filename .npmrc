engine-strict=true
fund=false
audit=false

# Permitir scripts de instalación de dependencias con native postinstall.
# Vercel CI (npm 10+) tiene allow-scripts OFF por defecto y da exit code 1
# si sharp (next/image native) o unrs-resolver (turbopack resolver) no
# ejecutan su postinstall. El campo package.json > allowScripts a veces
# no se evalúa correctamente en runners, .npmrc es fuente de verdad.
allow-scripts=true
