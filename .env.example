# =====================================================
# RIFASCENTER · ENVIRONMENT TEMPLATE
# =====================================================
# Copia este archivo a `.env.local` y rellénalo con tus credenciales.
# NUNCA hagas commit del archivo con valores reales.

# ---------- NEXT.JS -----------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=RifasCenter
NEXT_PUBLIC_APP_ENV=development

# ---------- SUPABASE ----------------------------------
# Crea un proyecto en https://supabase.com/dashboard
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXX

# ⚠️ SOLO para server-side / API Routes / Edge Functions (NUNCA exponer al navegador)
# Project Settings → API → service_role (reveal)
SUPABASE_SERVICE_ROLE_KEY=

# ---------- MERCADO PAGO ------------------------------
# Credenciales de TEST primero (empiezan con TEST-).
# Panel Mercado Pago → Credenciales.
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=TEST-XXXXXXXXXXXXXXX
MERCADO_PAGO_ACCESS_TOKEN=TEST-XXXXXXXXXXXXXXXXXXXXXXX

# Secret para firmar webhooks (Mercado Pago → Webhooks → Secret)
MERCADO_PAGO_WEBHOOK_SECRET=

# ---------- ADSENSE (OPCIONAL BETA) -------------------
# Crea cuenta en Google AdSense, obten "ca-pub-XXXX"
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_NATIVE=

# ---------- CORREO / NOTIFICACIONES (OPCIONAL) --------
# Usa Supabase Email Auth defaults o configura Resend/SMTP
RESEND_API_KEY=

# ---------- MISC ---------------------------------------
# Token para proteger rutas /api/cron/*
CRON_SECRET=
